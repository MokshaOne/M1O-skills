{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/auto-push.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ory-agent-plugins": {
      "source": {
        "source": "directory",
        "path": "/root/.config/ory-agent-plugins/claude-code"
      }
    }
  },
  "enabledPlugins": {
    "ory-agent-plugin@ory-agent-plugins": true
  }
}
